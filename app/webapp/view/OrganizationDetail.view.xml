<mvc:View
  controllerName="itsm.ui.controller.OrganizationDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:u="sap.ui.unified"
  displayBlock="true">

  <Page id="orgDetailPage" showHeader="false" backgroundDesign="Transparent" class="appBg densePage">

    <Bar class="appHeader">
      <contentLeft>
        <Button icon="sap-icon://nav-back" type="Transparent" tooltip="Back" press=".onBack" class="sapUiTinyMarginEnd"/>
        <Image src="images/ccentrik.png" height="30px" densityAware="false" class="appLogo"/>
      </contentLeft>
      <contentMiddle>
        <Title text="{name}" class="appHeaderTitle"/>
      </contentMiddle>
    </Bar>

    <IconTabBar id="orgTabs" expanded="true" class="sapUiSmallMarginTop">
      <items>

        <IconTabFilter text="Details" key="details">
          <VBox class="sectionCard">
            <Text text="ORGANIZATION DETAILS" class="sectionPill"/>
            <VBox class="formGrid">
              <VBox class="formField">
                <Label text="Organization Name" required="true"/>
                <Input value="{name}" width="100%"/>
              </VBox>
              <VBox class="formField">
                <Label text="Code" required="true"/>
                <Input value="{code}" width="100%"/>
              </VBox>
              <VBox class="formField">
                <Label text="Status"/>
                <Switch state="{isActive}" customTextOn="Active" customTextOff="Inactive"/>
              </VBox>
            </VBox>
            <Button text="Save Details" type="Emphasized" class="saveBtn sapUiSmallMarginTop" press=".onSaveDetails"/>
          </VBox>
        </IconTabFilter>

        <IconTabFilter text="Users" key="users">
          <VBox class="sectionCard">
            <Text text="ORGANIZATION USERS" class="sectionPill"/>
            <MessageStrip
              text="A new user is emailed a link to set their own password. You never see or set it."
              type="Information" showIcon="true" showCloseButton="false" class="attachmentsNote"/>

            <Table id="orgUsersTable"
              items="{ path: '/Users', parameters: { $select: 'ID,userId,name,email,role,isActive,client' }, sorter: { path: 'name' } }"
              noDataText="No users in this organization yet.">
              <headerToolbar>
                <OverflowToolbar style="Clear">
                  <ToolbarSpacer/>
                  <Button text="Add User" icon="sap-icon://add" class="submitBtn" press=".onAddUser"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column width="10rem"><Text text="Name"/></Column>
                <Column width="14rem"><Text text="Email"/></Column>
                <Column width="10rem"><Text text="Role"/></Column>
                <Column width="7rem"><Text text="Status"/></Column>
                <Column width="9rem"/>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{name}"/>
                    <Text text="{email}"/>
                    <Text text="{path: 'role', formatter: '.formatRoleLabel'}"/>
                    <ObjectStatus text="{= ${isActive} ? 'Active' : 'Inactive' }" state="{= ${isActive} ? 'Success' : 'Error' }"/>
                    <HBox>
                      <Button icon="sap-icon://edit" type="Transparent" tooltip="Edit User" press=".onEditUser"/>
                      <Button icon="sap-icon://email" type="Transparent" tooltip="Resend Password Setup Link" press=".onResendPasswordSetup"/>
                      <Button icon="sap-icon://delete" type="Transparent" tooltip="Delete User" press=".onDeleteUser"/>
                    </HBox>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </VBox>
        </IconTabFilter>

        <IconTabFilter text="Theme" key="theme">
          <VBox class="sectionCard">
            <Text text="ORGANIZATION THEME" class="sectionPill"/>
            <VBox class="formGrid">
              <VBox class="formField">
                <Label text="Theme Type"/>
                <Select id="themeTypeSelect" selectedKey="{themeType}" width="100%">
                  <core:Item key="SOLID" text="Single Color"/>
                  <core:Item key="GRADIENT" text="Gradient"/>
                </Select>
              </VBox>
              <VBox class="formField">
                <Label text="Apply Theme To"/>
                <Select id="themeScopeSelect" selectedKey="{themeScope}" width="100%">
                  <core:Item key="HEADER" text="Header strip &amp; buttons only"/>
                  <core:Item key="BACKGROUND" text="Whole app background"/>
                </Select>
              </VBox>
              <VBox class="formField">
                <Label text="Primary Color"/>
                <HBox class="colorPickRow">
                  <Input id="primaryColorInput" value="{primaryColor}" placeholder="#2a78d6" width="100%"/>
                  <Button icon="sap-icon://palette" tooltip="Pick a color" press=".onPickPrimaryColor" class="colorPickBtn"/>
                </HBox>
              </VBox>
              <VBox class="formField" visible="{= ${themeType} === 'GRADIENT'}">
                <Label text="Secondary Color"/>
                <HBox class="colorPickRow">
                  <Input id="secondaryColorInput" value="{secondaryColor}" placeholder="#021a86" width="100%"/>
                  <Button icon="sap-icon://palette" tooltip="Pick a color" press=".onPickSecondaryColor" class="colorPickBtn"/>
                </HBox>
              </VBox>
              <VBox class="formField formFieldWide">
                <Label text="Logo"/>
                <HBox alignItems="Center" class="logoUploadRow">
                  <Image src="{= ${logo} || 'images/ccentrik.png' }" height="26px" class="logoPreviewThumb"/>
                  <u:FileUploader
                    id="logoFileUploader"
                    buttonOnly="true"
                    iconFirst="true"
                    icon="sap-icon://upload"
                    buttonText="Upload Logo"
                    style="Transparent"
                    change=".onLogoFileSelected"
                    class="attachmentsUploadBtn"/>
                  <Button text="Remove" type="Transparent" visible="{= !!${logo} }" press=".onRemoveLogo"/>
                </HBox>
                <Text text="Leave empty to use the default ccentrik logo." class="fieldHint"/>
              </VBox>
            </VBox>

            <!-- Button colors are separate from the header/background theme
                 above — always a flat color, never the gradient, and split
                 into two independently controlled groups. -->
            <Text text="New Ticket Button" class="subPill sapUiSmallMarginTop"/>
            <VBox class="formGrid">
              <VBox class="formField">
                <Label text="Button Color"/>
                <HBox class="colorPickRow">
                  <Input id="newTicketBtnColorInput" value="{newTicketBtnColor}" placeholder="#2563eb" width="100%"/>
                  <Button icon="sap-icon://palette" tooltip="Pick a color" press=".onPickNewTicketBtnColor" class="colorPickBtn"/>
                </HBox>
              </VBox>
              <VBox class="formField">
                <Label text="Text Color"/>
                <HBox class="colorPickRow">
                  <Input id="newTicketBtnTextColorInput" value="{newTicketBtnTextColor}" placeholder="#ffffff" width="100%"/>
                  <Button icon="sap-icon://palette" tooltip="Pick a color" press=".onPickNewTicketBtnTextColor" class="colorPickBtn"/>
                </HBox>
              </VBox>
            </VBox>

            <Text text="Form Buttons (Delete / Save / Submit)" class="subPill sapUiSmallMarginTop"/>
            <VBox class="formGrid">
              <VBox class="formField">
                <Label text="Button Color"/>
                <HBox class="colorPickRow">
                  <Input id="formBtnColorInput" value="{formBtnColor}" placeholder="#3b82f6" width="100%"/>
                  <Button icon="sap-icon://palette" tooltip="Pick a color" press=".onPickFormBtnColor" class="colorPickBtn"/>
                </HBox>
              </VBox>
              <VBox class="formField">
                <Label text="Text Color"/>
                <HBox class="colorPickRow">
                  <Input id="formBtnTextColorInput" value="{formBtnTextColor}" placeholder="#ffffff" width="100%"/>
                  <Button icon="sap-icon://palette" tooltip="Pick a color" press=".onPickFormBtnTextColor" class="colorPickBtn"/>
                </HBox>
              </VBox>
            </VBox>

            <Text text="Preview — this org's End User screen" class="subPill sapUiSmallMarginTop"/>
            <core:HTML content="{parts: ['themeType', 'themeScope', 'primaryColor', 'secondaryColor', 'logo', 'code', 'newTicketBtnColor', 'newTicketBtnTextColor', 'formBtnColor', 'formBtnTextColor'], formatter: '.formatThemePreviewHtml'}"/>

            <Button text="Save Theme" type="Emphasized" class="saveBtn sapUiSmallMarginTop" press=".onSaveTheme"/>
          </VBox>
        </IconTabFilter>

      </items>
    </IconTabBar>

    <!-- ===== Add/Edit User (one dialog, reused for both — see onAddUser/
         onEditUser): client is set programmatically to this org's code,
         not shown here — Admin role isn't offered, it's a platform-level
         role, not assignable per organization. Email doubles as the
         username (User.userId) — that's the exact string CAP sees as
         req.user.id for a real BTP login, so keeping one field instead of
         two avoids a typed value silently not matching. ===== -->
    <Dialog id="addUserDialog" title="Add User" contentWidth="24rem">
      <VBox class="sapUiSmallMargin">
        <Label text="Email" required="true"/>
        <Input id="newUserEmail" width="100%" class="sapUiTinyMarginBottom"/>
        <Label text="Name" required="true"/>
        <Input id="newUserName" width="100%" class="sapUiTinyMarginBottom"/>
        <Label text="Roles" required="true"/>
        <MultiComboBox id="newUserRoles" width="100%" class="sapUiTinyMarginBottom">
          <core:Item key="END_USER" text="End User"/>
          <core:Item key="SERVICE_GROUP" text="Service Group"/>
          <core:Item key="CONSULTANT" text="Consultant"/>
        </MultiComboBox>
        <Text text="Pick one or more. With more than one, the user chooses which to work as after login." class="fieldHint sapUiTinyMarginBottom"/>
        <Label text="Status"/>
        <Switch id="newUserActive" state="true" customTextOn="Active" customTextOff="Inactive"/>
      </VBox>
      <beginButton>
        <Button id="userDialogSaveBtn" text="Create" type="Emphasized" press=".onSaveUser"/>
      </beginButton>
      <endButton>
        <Button text="Cancel" press=".onCancelUserDialog"/>
      </endButton>
    </Dialog>

    <!-- ===== Crop the logo before it's uploaded: drag to reposition, slider
         to zoom, both over a fixed-aspect frame matching the header's shape
         (see onLogoFileSelected / crop handlers in the controller). ===== -->
    <Dialog id="logoCropDialog" title="Crop Logo" contentWidth="22rem" afterOpen=".onLogoCropDialogAfterOpen" afterClose=".onLogoCropDialogAfterClose">
      <VBox class="sapUiSmallMargin" alignItems="Center">
        <SegmentedButton id="logoCropShape" selectedKey="WIDE" select=".onLogoCropShapeChange" class="sapUiTinyMarginBottom">
          <items>
            <SegmentedButtonItem key="WIDE" text="Wide"/>
            <SegmentedButtonItem key="SQUARE" text="Square"/>
            <SegmentedButtonItem key="TALL" text="Tall"/>
          </items>
        </SegmentedButton>
        <core:HTML id="logoCropCanvasHost" content="&lt;div class='logoCropFrame'&gt;&lt;canvas id='logoCropCanvas' width='320' height='100'&gt;&lt;/canvas&gt;&lt;/div&gt;"/>
        <Label text="Zoom" class="sapUiTinyMarginTop"/>
        <Slider id="logoCropZoom" min="1" max="3" step="0.05" value="1" width="100%" liveChange=".onLogoCropZoomChange"/>
        <Text text="Pick the shape closest to your logo, then drag to reposition it." class="fieldHint sapUiTinyMarginTop"/>
      </VBox>
      <beginButton>
        <Button text="Apply &amp; Upload" type="Emphasized" press=".onApplyLogoCrop"/>
      </beginButton>
      <endButton>
        <Button text="Cancel" press=".onCancelLogoCrop"/>
      </endButton>
    </Dialog>

  </Page>
</mvc:View>
