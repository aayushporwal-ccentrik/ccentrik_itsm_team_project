# Copy to .env for local dev. .env is gitignored — never commit real values.

# Required. Long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

JWT_ISSUER=itsm
JWT_AUDIENCE=itsm-app
JWT_ACCESS_TOKEN_EXPIRY=8h

# Base URL the UI5 app is served from — used to build password setup/reset links.
APP_URL=http://localhost:4004/webapp

# Password setup, reset and ticket notification emails. Without SMTP_HOST the
# password link is printed to the server console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---------- Authentication provider ----------
# "local" (default, cds watch) or "cognito" (cds watch --profile hybrid / AWS).
AUTH_PROVIDER=local

# Required only when AUTH_PROVIDER=cognito.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Leave empty for a public app client (recommended) - set only if the app
# client was created with a secret.
COGNITO_CLIENT_SECRET=
