{
  "name": "ITSM",
  "version": "1.0.0",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1119.0",
    "@cap-js/hana": "^2",
    "@cap-js/postgres": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "aws-jwt-verify": "^5.2.1",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db/itsm.sqlite"
          }
        },
        "auth": {
          "impl": "srv/auth.js",
          "provider": "local"
        }
      },
      "auth": {
        "impl": "srv/auth.js"
      },
      "[hybrid]": {
        "db": "hana",
        "auth": {
          "impl": "srv/auth.js",
          "provider": "cognito"
        }
      },
      "db": "hana"
    }
  }
}
